{
  "name": "iscrapemdb",
  "version": "2.0.0",
  "description": "Real IMDb-only crawler (TypeScript). No API keys, resilient WAF handling, bulk datasets + browser engine.",
  "type": "module",
  "license": "Polyform-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "iscrapemdb": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/cli.js",
    "scrape": "node ./dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no linter configured\""
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
